@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

<div class="app-shell">
    <header class="topbar">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true">K</span>
            Kanban
        </a>
        <span class="spacer"></span>
        <AuthorizeView>
            <Authorized>
                <span class="user-email" title="@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value">
                    @context.User.Identity?.Name
                </span>
                <a class="btn btn-ghost btn-icon" href="settings" title="Ajustes" aria-label="Ajustes">⚙</a>
                <button class="btn btn-ghost" @onclick="LogoutAsync">Salir</button>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="page-content">
        @Body
    </main>
</div>

@code {
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login");
    }
}
